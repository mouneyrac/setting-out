{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "worker-configuration.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.astro"
  ],
  // `.astro` must NOT be listed here. It holds the generated types.d.ts that
  // gives astro:content its real types; excluding the directory silently
  // filtered it back out of `include`, and getCollection() degraded to the
  // `(...args: any[]) => any` stub in astro/types/content.d.ts — which is
  // where ~39 phantom implicit-any errors came from.
  "exclude": ["dist", "node_modules", ".wrangler"],
  "compilerOptions": {
    // The Workers runtime types land globally whatever we do here: the
    // @astrojs/cloudflare adapter's `Runtime` type pulls them in through
    // .astro/types.d.ts. Their `Element` (HTMLRewriter's) merges with the DOM
    // one and overrides `append`, so in client scripts `el.append(node)` is
    // checked against `append(string | Response | ReadableStream)`.
    //
    // That is why client scripts use `appendChild` — see CONTRIBUTING.md. It is
    // also why `tsconfig.server.json` exists: server code should be read
    // against the Workers lib, and it is the one this project gates the build on.
    "types": ["astro/client"],
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  }
}
