---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ResourceCard from '../../../components/ResourceCard.astro';
import VideoCard from '../../../components/VideoCard.astro';
import DeliverableForm from '../../../components/DeliverableForm.astro';
import { getPhase } from '../../../data/phases';
import { getUser } from '../../../lib/server';
import {
  allLessons,
  lessonSlug,
  lessonUrl,
  neighbours,
  difficultyLabel,
} from '../../../lib/curriculum';

/**
 * Lesson content is behind an account.
 *
 * The course map — phases, lesson titles, summaries, times — stays public,
 * because seeing all ninety-one titles is the best argument for signing up and
 * because it is already visible in the public repository anyway. What an
 * account gets you is the lesson itself, plus progress and the workbook.
 *
 * This means lessons render on demand rather than at build time, so they are
 * not in the Pagefind index — the search dialog merges a small prerendered
 * lesson index instead. See /lessons-index.json.
 */
export const prerender = false;

const lessons = await allLessons();
const lesson = lessons.find(
  (l) =>
    getPhase(l.data.phase).slug === Astro.params.phase && lessonSlug(l) === Astro.params.lesson,
);
if (!lesson) return new Response(null, { status: 404 });

const user = await getUser(Astro.request);
if (!user) {
  // Come back here once they have signed in, rather than dumping them on /my/.
  return Astro.redirect(`/sign-in/?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const d = lesson.data;
const phase = getPhase(d.phase);
const { prev, next } = neighbours(lessons, lesson);
const { Content } = await render(lesson);

const freeCount = d.resources.filter((r) => r.cost === 'free').length;
const phaseLessons = lessons.filter((l) => l.data.phase === d.phase);
---

<Base title={d.title} description={d.summary}>
  <article class="mx-auto max-w-[84rem] px-4 sm:px-6" data-pagefind-body data-lesson-id={lesson.id}>
    <!-- ── Header ────────────────────────────────────────────────── -->
    <header class="pt-8 pb-8">
      <nav class="label flex items-center gap-2 flex-wrap" aria-label="Breadcrumb">
        <a href="/curriculum/" class="hover:text-paw transition-colors">The path</a>
        <span aria-hidden="true">›</span>
        <a href={`/curriculum/${phase.slug}/`} class="hover:text-paw transition-colors">
          {String(d.phase).padStart(2, '0')} — {phase.title}
        </a>
      </nav>

      <h1
        class="mt-4 font-display font-900 leading-[1.08] max-w-[24ch]"
        style="font-size: clamp(1.9rem, 1.25rem + 2.9vw, 3.4rem);"
      >
        {d.title}
      </h1>

      <p class="mt-4 text-lg sm:text-xl leading-relaxed max-w-[66ch] text-soft">{d.summary}</p>

      <div class="mt-5 flex flex-wrap gap-2">
        <span class="cutout px-3 py-1 text-sm font-display font-700">⏱ {d.timeEstimate}</span>
        <span class="cutout px-3 py-1 text-sm font-display font-700">
          {difficultyLabel[d.difficulty]}
        </span>
        {
          d.series && (
            <span class="cutout px-3 py-1 text-sm font-display font-700 text-jac">
              💧 {d.series}
            </span>
          )
        }
        {
          d.resources.length > 0 && (
            <span class="cutout px-3 py-1 text-sm font-display font-700">
              🔗 {d.resources.length} resources ({freeCount} free)
            </span>
          )
        }
        {
          d.status === 'stub' && (
            <span
              class="px-3 py-1 text-sm font-display font-700 rounded-2xl border-2"
              style="border-color: var(--banksia); color: var(--banksia);"
            >
              Not written yet
            </span>
          )
        }
      </div>
    </header>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-12 pb-4">
      <!-- ── Main column ─────────────────────────────────────────── -->
      <div class="min-w-0">
        {/* The honest state of the DOING, which is not the state of the writing. */}
        {
          d.fieldStatus === 'field-tested' ? (
            <aside
              class="mb-6 rounded-[14px] border-[3px] p-4"
              style="border-color: var(--leaf); background: color-mix(in srgb, var(--leaf) 12%, var(--surface));"
            >
              <p class="font-display font-700 leading-tight">
                <span aria-hidden="true">✅</span> Field-tested — this has actually been done
              </p>
              {d.fieldNotes && <p class="mt-2 leading-relaxed">{d.fieldNotes}</p>}
              {d.fieldTestedOn && (
                <p class="label mt-2">
                  Carried out{' '}
                  {d.fieldTestedOn.toLocaleDateString('en-AU', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </p>
              )}
            </aside>
          ) : (
            /* One line, not a panel. This appears on all 91 lessons; repeated at
               full length it stops being read and just costs a screenful. The
               explanation lives on /tracker/ and /about/. */
            <p class="mb-6 flex flex-wrap items-baseline gap-x-2 text-[0.95rem] leading-snug">
              <span aria-hidden="true">{d.fieldStatus === 'in-progress' ? '🚧' : '📖'}</span>
              <span class="font-display font-700">
                {d.fieldStatus === 'in-progress'
                  ? 'Being done right now'
                  : 'Researched, not yet done'}
              </span>
              <span class="text-soft">— sources checked, but nobody has built this yet.</span>
              <a href="/tracker/" class="underline underline-offset-2 hover:text-paw">
                What that means
              </a>
            </p>
          )
        }

        {
          d.licensedTrade && (
            <aside class="sign sign-danger mb-8">
              <div class="flex gap-3 items-start">
                <span class="text-2xl shrink-0" aria-hidden="true">
                  ⚠️
                </span>
                <div>
                  <p class="font-display font-700 text-lg leading-tight">
                    This work needs a licensed trade in WA
                  </p>
                  <p class="mt-1.5 leading-relaxed">{d.licensedTrade}</p>
                </div>
              </div>
            </aside>
          )
        }

        {
          d.status === 'stub' ? (
            <div class="cutout p-5 sm:p-7">
              <span class="text-3xl" aria-hidden="true">
                🌱
              </span>
              <h2 class="font-display font-900 text-2xl sm:text-3xl mt-2.5 leading-tight">
                Not planted yet — but the plan for it is final
              </h2>
              <p class="mt-3 leading-relaxed text-soft max-w-[62ch]">
                The practical task and the checklist below are exactly what this lesson will teach.
                What is missing is the written explanation and the curated links, each one fetched
                and verified before it ships.
              </p>
              <p class="mt-3 leading-relaxed text-soft max-w-[62ch]">
                In the meantime the checklist is genuinely usable on its own. Take it outside.
              </p>
            </div>
          ) : (
            <div class="prose-garden">
              <Content />
            </div>
          )
        }

        {d.deliverable && <DeliverableForm deliverable={d.deliverable} lessonId={lesson.id} />}

        {
          d.checklist.length > 0 && (
            <section class="mt-10" data-checklist={lesson.id}>
              <div class="flex flex-wrap items-baseline gap-x-3">
                <h2 class="font-display font-900 text-2xl sm:text-3xl">Checklist</h2>
                <span class="label" data-checklist-count />
              </div>
              <p class="note mt-1">
                Ticks are saved to your account, so this survives being closed.
              </p>
              <ul class="mt-4 grid gap-2">
                {d.checklist.map((item, i) => (
                  <li>
                    <label class="marker flex gap-3 p-3.5 items-start cursor-pointer">
                      <input
                        type="checkbox"
                        data-check={i}
                        class="w-5 h-5 mt-0.5 shrink-0 accent-[var(--leaf)] cursor-pointer"
                      />
                      <span class="leading-snug">{item}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          d.videos.length > 0 && (
            <section class="mt-10">
              <h2 class="font-display font-900 text-2xl sm:text-3xl">Watch</h2>
              <div class="grid gap-4 sm:grid-cols-2 mt-4">
                {d.videos.map((v) => (
                  <VideoCard video={v} />
                ))}
              </div>
            </section>
          )
        }

        {
          d.resources.length > 0 && (
            <section class="mt-10">
              <h2 class="font-display font-900 text-2xl sm:text-3xl">Where to go deeper</h2>
              <p class="note mt-1">
                Every link below was fetched and checked before it shipped. Nothing here is a guess.
              </p>
              <ul class="grid gap-3 mt-4">
                {d.resources.map((r) => (
                  <ResourceCard resource={r} />
                ))}
              </ul>
            </section>
          )
        }

        {
          d.regulations.length > 0 && (
            <section class="mt-10">
              <h2 class="font-display font-900 text-2xl sm:text-3xl">The rules, with sources</h2>
              <p class="note mt-1">
                WA regulation changes. Each point below names its primary source and the date it was
                last checked — always confirm with your own council before you build.
              </p>
              <ul class="grid gap-3 mt-4">
                {d.regulations.map((reg) => (
                  <li class="sign list-none">
                    <p class="leading-relaxed">{reg.claim}</p>
                    <p class="label mt-2">
                      <a
                        href={reg.sourceUrl}
                        class="underline underline-offset-2 hover:text-paw transition-colors"
                      >
                        {reg.source} ↗
                      </a>
                      {' · checked '}
                      {reg.checkedOn.toLocaleDateString('en-AU', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      })}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <!-- ── Side rail ───────────────────────────────────────────── -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="cutout overflow-hidden">
          <p class="label px-4 pt-3.5 pb-2">
            Phase {String(d.phase).padStart(2, '0')} — {phase.title}
          </p>
          <ol class="max-h-[58vh] overflow-y-auto pb-1">
            {
              phaseLessons.map((l) => {
                const current = l.id === lesson.id;
                return (
                  <li>
                    <a
                      href={lessonUrl(l)}
                      aria-current={current ? 'page' : undefined}
                      class:list={[
                        'flex gap-2.5 px-4 py-2.5 text-[0.92rem] leading-snug border-l-4 transition-colors',
                        current
                          ? 'border-[var(--paw)] text-paw font-500'
                          : 'border-transparent text-soft hover:text-ink hover:bg-surface-2',
                      ]}
                    >
                      <span class="font-display font-700 text-xs pt-0.5 shrink-0 opacity-70">
                        {String(l.data.order).padStart(2, '0')}
                      </span>
                      <span>{l.data.title}</span>
                    </a>
                  </li>
                );
              })
            }
          </ol>
        </div>

        <button
          type="button"
          data-mark-done
          class="btn btn-ghost w-full justify-center mt-3 text-[0.95rem]"
          hidden
        >
          <span data-mark-label>Mark this lesson done</span>
        </button>
      </aside>
    </div>

    <!-- ── Prev / next ───────────────────────────────────────────── -->
    <nav class="mt-12 mb-16 grid gap-3 sm:grid-cols-2">
      {
        prev ? (
          <a href={lessonUrl(prev)} class="cutout cutout-lift p-4 sm:p-5">
            <p class="label">← Previous</p>
            <p class="font-display font-700 text-lg mt-1 leading-tight">{prev.data.title}</p>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={lessonUrl(next)} class="cutout cutout-lift p-4 sm:p-5 sm:text-right">
            <p class="label">Next →</p>
            <p class="font-display font-700 text-lg mt-1 leading-tight">{next.data.title}</p>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  <script>
    import { useSession } from '../../../lib/session';
    import { rememberLesson } from '../../../lib/lesson/last-visited';
    import { initChecklist } from '../../../lib/lesson/checklist';
    import { initMarkDone } from '../../../lib/lesson/mark-done';

    // Lesson pages are prerendered for speed, so anything account-specific is
    // filled in here after load. Each piece works on its own; the session only
    // decides what gets shown.
    const article = document.querySelector<HTMLElement>('[data-lesson-id]');
    const lessonId = article?.dataset.lessonId ?? '';

    rememberLesson({
      href: location.pathname,
      title: document.querySelector('h1')?.textContent?.trim() ?? '',
      id: lessonId,
    });

    const checklist = initChecklist(document, lessonId);
    const markDone = initMarkDone(document, lessonId);

    useSession()
      .then((me) => {
        if (!me.signedIn) return;
        checklist?.hydrate(me.workbook);
        markDone?.hydrate(me.progress);
      })
      .catch(() => {
        /* Signed out or offline — the page works fine without any of this. */
      });
  </script>
</Base>
