---
import Base from '../../layouts/Base.astro';
import { allLessons } from '../../lib/curriculum';
import { phases } from '../../data/phases';

const lessons = await allLessons();

const all = lessons.flatMap((lesson) =>
  lesson.data.resources.map((resource) => ({ resource, phase: lesson.data.phase })),
);

const free = all.filter((e) => e.resource.cost === 'free').length;
const waSpecific = all.filter((e) => e.resource.waRelevance === 'wa-specific').length;

const byPhase = phases.map((phase) => ({
  phase,
  count: all.filter((e) => e.phase === phase.number).length,
  free: all.filter((e) => e.phase === phase.number && e.resource.cost === 'free').length,
}));

/** Unique sources, so the page can say who the material actually comes from. */
const providers = new Map<string, number>();
for (const { resource } of all) {
  providers.set(resource.provider, (providers.get(resource.provider) ?? 0) + 1);
}
const topProviders = [...providers.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);
---

<Base
  title="Resource library"
  description="Every external course, video, book, standard, tool and government source used across the curriculum — each one fetched and verified, priced, and annotated with why it is worth your time and what to change for Perth conditions."
>
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10"
      style="background: linear-gradient(180deg, var(--sky-low) 0%, var(--paper) 74%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-[84rem] px-4 sm:px-6 pt-12 pb-8">
      <p class="label">Resource library</p>
      <h1
        class="mt-2 font-display font-900 leading-[1.06] max-w-[18ch]"
        style="font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.25rem);"
      >
        Everything worth reading, watching or paying for
      </h1>
      <p class="mt-5 max-w-[64ch] text-lg leading-relaxed text-soft">
        Every resource used anywhere in the course. Each one says what it costs, how long it takes,
        why it earned its place over the alternatives, and — where it was written for somewhere
        other than Perth — exactly what you need to change.
      </p>

      <dl class="mt-7 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="cutout p-4">
          <dt class="label">Total</dt>
          <dd class="font-display font-900 text-4xl mt-1 leading-none tabular-nums">{all.length}</dd>
        </div>
        <div class="cutout p-4">
          <dt class="label">Free</dt>
          <dd class="font-display font-900 text-4xl mt-1 leading-none tabular-nums text-leaf">
            {free}
          </dd>
        </div>
        <div class="cutout p-4">
          <dt class="label">Perth / WA</dt>
          <dd class="font-display font-900 text-4xl mt-1 leading-none tabular-nums text-jac">
            {waSpecific}
          </dd>
        </div>
        <div class="cutout p-4">
          <dt class="label">Sources</dt>
          <dd class="font-display font-900 text-4xl mt-1 leading-none tabular-nums">
            {providers.size}
          </dd>
        </div>
      </dl>

      <div class="sign mt-6 max-w-[76ch]">
        <p class="leading-relaxed">
          <strong class="font-display">Every link here was fetched before it shipped</strong>, then
          re-checked by a second pass that refetched each URL and confirmed the page still says what
          the annotation claims. Anything that 404ed or had drifted was removed rather than left in
          place. That is the whole point of this library — it would be trivially easy, and useless,
          to fill it with plausible links.
        </p>
      </div>
    </div>
  </section>

  <!-- ── By phase ─────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-[84rem] px-4 sm:px-6 pb-10">
    <h2 class="font-display font-900 text-2xl sm:text-3xl">Browse by phase</h2>
    <p class="note mt-1 max-w-[64ch]">
      Split by phase so each page stays light enough to open on a phone with two bars of signal.
      Looking for something specific? Press <kbd class="font-display">⌘K</kbd> and search the whole
      course.
    </p>

    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-5">
      {
        byPhase.map(({ phase, count, free: freeCount }) => (
          <li class="list-none">
            <a href={`/resources/${phase.slug}/`} class="cutout cutout-lift p-5 block h-full">
              <div class="flex items-baseline gap-2.5">
                <span class="font-display font-900 text-2xl text-soft tabular-nums">
                  {String(phase.number).padStart(2, '0')}
                </span>
                <h3 class="font-display font-700 text-xl leading-tight">{phase.title}</h3>
              </div>
              <p class="note mt-1">{phase.tagline}</p>
              <p class="mt-3">
                <span class="font-display font-900 text-3xl leading-none tabular-nums text-leaf">
                  {count}
                </span>
                <span class="label ml-2">resources · {freeCount} free</span>
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── Where it comes from ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-[84rem] px-4 sm:px-6 pb-16">
    <h2 class="font-display font-900 text-2xl sm:text-3xl">Where the material comes from</h2>
    <p class="note mt-1 max-w-[64ch]">
      Authoritative Western Australian sources are preferred over content marketing. These are the
      most-cited.
    </p>
    <ul class="flex flex-wrap gap-2 mt-4">
      {
        topProviders.map(([provider, count]) => (
          <li class="cutout px-3.5 py-1.5 list-none">
            <span class="font-display font-700 text-sm">{provider}</span>
            <span class="label ml-2">{count}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
