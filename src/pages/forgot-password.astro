---
import Base from '../layouts/Base.astro';
---

<Base
  title="Forgotten password"
  description="Send yourself a link to choose a new password for your Setting Out account."
>
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10"
      style="background: linear-gradient(180deg, var(--sky-low) 0%, var(--paper) 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-[38rem] px-4 sm:px-6 pt-12 pb-16">
      <p class="label">Account</p>
      <h1
        class="mt-2 font-display font-900 leading-[1.08]"
        style="font-size: clamp(1.9rem, 1.4rem + 2.2vw, 2.75rem);"
      >
        Forgotten your password?
      </h1>
      <p class="mt-4 leading-relaxed text-soft">
        Put in the email you signed up with and we will send you a link to choose a new one. The
        link lasts an hour.
      </p>

      <div class="cutout p-5 sm:p-7 mt-7">
        <!-- Shown when no mail provider is configured, so nobody waits for an
             email that is never coming. -->
        <div id="no-email" class="sign" hidden>
          <p class="font-display font-700 text-lg leading-tight">
            Password reset is not switched on yet
          </p>
          <p class="mt-2 leading-relaxed">
            This site has no email provider configured, so it cannot send you a reset link. If you
            are locked out, the honest answer is to sign up again with a different email — or ask
            whoever runs this instance to set <code>RESEND_API_KEY</code>.
          </p>
          <p class="mt-2 leading-relaxed">
            Nothing on the course itself needs an account. Every lesson is readable signed out.
          </p>
        </div>

        <form id="forgot-form" class="grid gap-4" novalidate hidden>
          <div>
            <label class="label block mb-1" for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full rounded-xl border-2 border-edge bg-surface px-3.5 py-2.5"
            />
          </div>

          <p
            id="forgot-message"
            class="rounded-xl px-3.5 py-2.5 leading-snug"
            hidden
            role="status"
          >
          </p>

          <button type="submit" class="btn btn-primary justify-center" id="forgot-submit">
            <span id="forgot-label">Send the link</span>
          </button>
        </form>
      </div>

      <p class="note mt-5">
        <a href="/sign-in/" class="underline underline-offset-2 hover:text-paw">
          Back to signing in
        </a>
      </p>
    </div>
  </section>

  <script>
    const form = document.getElementById('forgot-form') as HTMLFormElement;
    const noEmail = document.getElementById('no-email') as HTMLElement;
    const message = document.getElementById('forgot-message') as HTMLElement;
    const submit = document.getElementById('forgot-submit') as HTMLButtonElement;
    const label = document.getElementById('forgot-label') as HTMLElement;

    const show = (text: string, ok: boolean) => {
      message.textContent = text;
      message.hidden = false;
      message.style.background = ok
        ? 'color-mix(in srgb, var(--leaf) 14%, var(--surface))'
        : 'color-mix(in srgb, var(--paw) 12%, var(--surface))';
      message.style.border = `2px solid ${ok ? 'var(--leaf)' : 'var(--paw)'}`;
    };

    fetch('/api/auth-config')
      .then((r) => r.json())
      .then((config) => {
        if (config.passwordReset) form.hidden = false;
        else noEmail.hidden = false;
      })
      .catch(() => {
        noEmail.hidden = false;
      });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      submit.disabled = true;
      label.textContent = 'Sending…';

      const email = (document.getElementById('email') as HTMLInputElement).value.trim();

      try {
        await fetch('/api/auth/forget-password', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, redirectTo: '/reset-password/' }),
        });
        // Deliberately the same answer whether or not that email exists —
        // otherwise this page becomes a way to discover who has an account.
        show(
          'If there is an account with that email, a reset link is on its way. Check your spam folder too.',
          true,
        );
        form.querySelector('input')!.value = '';
      } catch {
        show('Could not reach the server. Check your connection and try again.', false);
      }

      submit.disabled = false;
      label.textContent = 'Send the link';
    });
  </script>
</Base>
