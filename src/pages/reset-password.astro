---
import Base from '../layouts/Base.astro';
---

<Base title="Choose a new password" description="Set a new password for your Setting Out account.">
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10"
      style="background: linear-gradient(180deg, var(--sky-low) 0%, var(--paper) 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-[38rem] px-4 sm:px-6 pt-12 pb-16">
      <p class="label">Account</p>
      <h1
        class="mt-2 font-display font-900 leading-[1.08]"
        style="font-size: clamp(1.9rem, 1.4rem + 2.2vw, 2.75rem);"
      >
        Choose a new password
      </h1>

      <div class="cutout p-5 sm:p-7 mt-7">
        <div id="no-token" class="sign" hidden>
          <p class="font-display font-700 text-lg leading-tight">This link is not valid</p>
          <p class="mt-2 leading-relaxed">
            Reset links expire after an hour and can only be used once. Ask for a fresh one.
          </p>
          <a href="/forgot-password/" class="btn btn-ghost text-sm py-2 px-4 mt-3">
            Send a new link
          </a>
        </div>

        <form id="reset-form" class="grid gap-4" novalidate hidden>
          <div>
            <label class="label block mb-1" for="password">New password</label>
            <input
              id="password"
              type="password"
              required
              minlength="10"
              autocomplete="new-password"
              class="w-full rounded-xl border-2 border-edge bg-surface px-3.5 py-2.5"
            />
            <p class="note mt-1">At least 10 characters.</p>
          </div>

          <div>
            <label class="label block mb-1" for="confirm">Type it again</label>
            <input
              id="confirm"
              type="password"
              required
              minlength="10"
              autocomplete="new-password"
              class="w-full rounded-xl border-2 border-edge bg-surface px-3.5 py-2.5"
            />
          </div>

          <p id="reset-message" class="rounded-xl px-3.5 py-2.5 leading-snug" hidden role="alert">
          </p>

          <button type="submit" class="btn btn-primary justify-center" id="reset-submit">
            <span id="reset-label">Save the new password</span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('reset-form') as HTMLFormElement;
    const noToken = document.getElementById('no-token') as HTMLElement;
    const message = document.getElementById('reset-message') as HTMLElement;
    const submit = document.getElementById('reset-submit') as HTMLButtonElement;
    const label = document.getElementById('reset-label') as HTMLElement;

    // Better Auth appends ?token=… when it sends you here.
    const token = new URLSearchParams(location.search).get('token');

    if (token) form.hidden = false;
    else noToken.hidden = false;

    const fail = (text: string) => {
      message.textContent = text;
      message.hidden = false;
      message.style.background = 'color-mix(in srgb, var(--paw) 12%, var(--surface))';
      message.style.border = '2px solid var(--paw)';
      submit.disabled = false;
      label.textContent = 'Save the new password';
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.hidden = true;

      const password = (document.getElementById('password') as HTMLInputElement).value;
      const confirm = (document.getElementById('confirm') as HTMLInputElement).value;

      if (password.length < 10) return fail('Passwords need to be at least 10 characters.');
      if (password !== confirm) return fail('Those two do not match.');

      submit.disabled = true;
      label.textContent = 'Saving…';

      try {
        const response = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ newPassword: password, token }),
        });

        if (response.ok) {
          location.href = '/sign-in/?reset=1';
          return;
        }

        const data = (await response.json().catch(() => ({}))) as Record<string, unknown>;
        const detail = typeof data.message === 'string' ? data.message : '';
        fail(
          /invalid|expired/i.test(detail)
            ? 'That link has expired or has already been used. Ask for a fresh one.'
            : detail || 'That did not work. Please try again.',
        );
      } catch {
        fail('Could not reach the server. Check your connection and try again.');
      }
    });
  </script>
</Base>
