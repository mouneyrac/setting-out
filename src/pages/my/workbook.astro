---
import { eq } from 'drizzle-orm';
import Base from '../../layouts/Base.astro';
import { getDb, getUser } from '../../lib/server';
import { workbookEntry } from '../../db/schema';
import { allLessons, lessonUrl } from '../../lib/curriculum';
import { getPhase } from '../../data/phases';

export const prerender = false;

const user = await getUser(Astro.request);
if (!user) return Astro.redirect('/sign-in/');

const rows = await getDb()
  .select({
    workbookKey: workbookEntry.workbookKey,
    content: workbookEntry.content,
    updatedAt: workbookEntry.updatedAt,
  })
  .from(workbookEntry)
  .where(eq(workbookEntry.userId, user.id));

const byKey = new Map(rows.map((r) => [r.workbookKey, r]));
const lessons = await allLessons();

/**
 * Answers are stored one per question, under `<workbookKey>.<question.key>`.
 * `list` and `table` values are JSON in the same text column, so they are
 * parsed here rather than in a second table.
 */
const parseValue = (type: string, raw: string): string | string[] | string[][] => {
  if (!raw) return '';
  if (type === 'list' || type === 'table' || type === 'file') {
    try {
      return JSON.parse(raw);
    } catch {
      return raw;
    }
  }
  return raw;
};

const sections = lessons
  .filter((l) => l.data.deliverable)
  .map((lesson) => {
    const d = lesson.data.deliverable!;
    const questions = d.questions ?? [];

    const answers = questions.map((q) => {
      const entry = byKey.get(`${d.workbookKey}.${q.key}`);
      const value = parseValue(q.type, entry?.content ?? '');
      const filled = Array.isArray(value) ? value.length > 0 : Boolean(value);
      return { q, value, filled, updatedAt: entry?.updatedAt ?? null };
    });

    // The single-blob shape from before questions existed, so nothing written
    // under the old scheme silently disappears.
    const legacy = byKey.get(d.workbookKey)?.content?.trim() ?? '';

    const done = answers.filter((a) => a.filled).length;
    return {
      lesson,
      phase: getPhase(lesson.data.phase),
      deliverable: d,
      answers,
      legacy,
      done,
      total: questions.length,
      started: done > 0 || Boolean(legacy),
      updatedAt:
        answers
          .map((a) => a.updatedAt)
          .filter(Boolean)
          .sort()
          .at(-1) ?? null,
    };
  });

const completeCount = sections.filter((s) => s.total > 0 && s.done === s.total).length;
const totalAnswers = sections.reduce((n, s) => n + s.total, 0);
const filledAnswers = sections.reduce((n, s) => n + s.done, 0);

/** Flat payload for the Markdown export, so the client does not re-derive it. */
const exportData = sections.map((s) => ({
  phase: s.phase.number,
  phaseTitle: s.phase.title,
  title: s.deliverable.title,
  legacy: s.legacy,
  answers: s.answers.map((a) => ({
    label: a.q.label,
    type: a.q.type,
    columns: a.q.columns ?? [],
    value: a.value,
  })),
}));
---

<Base
  title="Project workbook"
  description="Every document you have written for your own property, assembled in order."
>
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10"
      style="background: linear-gradient(180deg, var(--sky-low) 0%, var(--paper) 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-[62rem] px-4 sm:px-6 pt-10 pb-8">
      <nav class="label flex items-center gap-2" aria-label="Breadcrumb">
        <a href="/my/" class="hover:text-paw transition-colors">My garden</a>
        <span aria-hidden="true">›</span>
        <span>Workbook</span>
      </nav>

      <h1
        class="mt-4 font-display font-900 leading-[1.08]"
        style="font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);"
      >
        Your project workbook
      </h1>
      <p class="mt-4 leading-relaxed text-soft max-w-[64ch]">
        Every deliverable in the course, in the order you produce them. Filled in, these are a
        professional landscape design package for your own property — the thing you would otherwise
        have paid a designer for, except you understand every page of it.
      </p>

      <div class="flex flex-wrap items-center gap-2.5 mt-6 no-print">
        <span class="cutout px-4 py-1.5 text-sm font-display font-700">
          {completeCount} of {sections.length} finished
        </span>
        <span class="cutout px-4 py-1.5 text-sm font-display font-700">
          {filledAnswers} of {totalAnswers} answers
        </span>
        <button type="button" id="download" class="btn btn-primary text-sm py-2.5 px-5">
          Download as Markdown
        </button>
        <button type="button" id="print" class="btn btn-ghost text-sm py-2.5 px-5">Print</button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[62rem] px-4 sm:px-6 pb-16">
    <ol class="grid gap-4">
      {
        sections.map((s, i) => (
          <li class="list-none">
            <article
              class:list={['cutout p-5 sm:p-6', !s.started && 'opacity-70 no-print']}
              id={s.deliverable.workbookKey}
            >
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="phase-badge">{String(i + 1).padStart(2, '0')}</span>
                <div class="min-w-0 flex-1">
                  <p class="label">
                    Phase {String(s.phase.number).padStart(2, '0')} — {s.phase.title}
                  </p>
                  <h2 class="font-display font-700 text-xl sm:text-2xl leading-tight mt-0.5">
                    {s.deliverable.title}
                  </h2>
                </div>
                {s.total > 0 && (
                  <span class="label">
                    {s.done}/{s.total}
                  </span>
                )}
              </div>

              {s.started ? (
                <>
                  <dl class="mt-4 grid gap-4">
                    {s.answers
                      .filter((a) => a.filled)
                      .map((a) => (
                        <div>
                          <dt class="label">{a.q.label}</dt>
                          <dd class="mt-1 leading-relaxed">
                            {a.q.type === 'file' && Array.isArray(a.value) ? (
                              <ul class="grid gap-2 sm:grid-cols-2">
                                {(a.value as any[]).map((f: any) => (
                                  <li class="marker flex items-center gap-3 p-2.5">
                                    {String(f.type ?? '').startsWith('image/') ? (
                                      <img
                                        src={`/api/file/${f.key}`}
                                        alt=""
                                        loading="lazy"
                                        class="w-14 h-14 object-cover rounded-lg shrink-0"
                                      />
                                    ) : (
                                      <span
                                        class="w-14 h-14 grid place-items-center rounded-lg shrink-0 text-xl"
                                        style="background: var(--surface-2);"
                                        aria-hidden="true"
                                      >
                                        📄
                                      </span>
                                    )}
                                    <a
                                      href={`/api/file/${f.key}`}
                                      target="_blank"
                                      rel="noopener"
                                      class="min-w-0 truncate underline underline-offset-2 hover:text-paw"
                                    >
                                      {f.name}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            ) : a.q.type === 'list' && Array.isArray(a.value) ? (
                              <ul class="grid gap-1">
                                {(a.value as string[]).map((v) => (
                                  <li class="flex gap-2">
                                    <span class="text-paw" aria-hidden="true">
                                      —
                                    </span>
                                    <span>{v}</span>
                                  </li>
                                ))}
                              </ul>
                            ) : a.q.type === 'table' && Array.isArray(a.value) ? (
                              <div class="scroll-x">
                                <table class="template-table">
                                  <thead>
                                    <tr>
                                      {(a.q.columns ?? []).map((c) => (
                                        <th>{c}</th>
                                      ))}
                                    </tr>
                                  </thead>
                                  <tbody>
                                    {(a.value as string[][]).map((row) => (
                                      <tr>
                                        {row.map((cell) => (
                                          <td class="px-2 py-1.5">{cell}</td>
                                        ))}
                                      </tr>
                                    ))}
                                  </tbody>
                                </table>
                              </div>
                            ) : (
                              <span class="whitespace-pre-wrap">
                                {a.q.prefix}
                                {a.value as string}
                                {a.q.suffix ? ` ${a.q.suffix}` : ''}
                              </span>
                            )}
                          </dd>
                        </div>
                      ))}
                  </dl>

                  {s.legacy && (
                    <div class="mt-4 rounded-xl p-3" style="background: var(--surface-2);">
                      <p class="label">Written before this became a form</p>
                      <p class="mt-1 leading-relaxed whitespace-pre-wrap">{s.legacy}</p>
                    </div>
                  )}

                  {s.done < s.total && (
                    <p class="note mt-3 no-print">
                      {s.total - s.done} still to answer ·{' '}
                      <a
                        href={lessonUrl(s.lesson)}
                        class="underline underline-offset-2 hover:text-paw"
                      >
                        finish it in the lesson
                      </a>
                    </p>
                  )}
                </>
              ) : (
                <>
                  <ul class="mt-3 grid gap-1.5">
                    {s.answers.map((a) => (
                      <li class="flex gap-2 text-soft text-[0.95rem]">
                        <span aria-hidden="true">—</span>
                        <span class="leading-snug">{a.q.label}</span>
                      </li>
                    ))}
                  </ul>
                  <a
                    href={lessonUrl(s.lesson)}
                    class="btn btn-ghost text-sm py-2 px-4 mt-4 no-print"
                  >
                    Write this one →
                  </a>
                </>
              )}
            </article>
          </li>
        ))
      }
    </ol>
  </section>

  <style is:global>
    @media print {
      .no-print,
      header[class*='sticky'],
      footer {
        display: none !important;
      }
      body {
        background: #fff !important;
      }
    }
  </style>

  <script is:inline define:vars={{ sections: exportData }}>
    document.getElementById('print')?.addEventListener('click', () => window.print());

    document.getElementById('download')?.addEventListener('click', () => {
      const lines = ['# Landscape project workbook', ''];
      let phase = null;

      for (const s of sections) {
        if (s.phase !== phase) {
          phase = s.phase;
          lines.push(`## Phase ${String(s.phase).padStart(2, '0')} — ${s.phaseTitle}`, '');
        }
        lines.push(`### ${s.title}`, '');

        const answered = s.answers.filter((a) =>
          Array.isArray(a.value) ? a.value.length : a.value,
        );

        if (!answered.length && !s.legacy) {
          lines.push('_Not written yet._', '');
          continue;
        }

        for (const a of answered) {
          lines.push(`**${a.label}**`, '');
          if (a.type === 'file' && Array.isArray(a.value)) {
            for (const f of a.value)
              lines.push(`- ${f.name} (uploaded ${String(f.at).slice(0, 10)})`);
            lines.push('');
          } else if (a.type === 'list' && Array.isArray(a.value)) {
            for (const v of a.value) lines.push(`- ${v}`);
            lines.push('');
          } else if (a.type === 'table' && Array.isArray(a.value)) {
            if (a.columns.length) {
              lines.push(`| ${a.columns.join(' | ')} |`);
              lines.push(`| ${a.columns.map(() => '---').join(' | ')} |`);
            }
            for (const row of a.value) lines.push(`| ${row.join(' | ')} |`);
            lines.push('');
          } else {
            lines.push(String(a.value), '');
          }
        }

        if (s.legacy) lines.push('_Written before this became a form:_', '', s.legacy, '');
      }

      const blob = new Blob([lines.join('\n')], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'landscape-project-workbook.md';
      a.click();
      URL.revokeObjectURL(url);
    });
  </script>
</Base>
