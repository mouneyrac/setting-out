---
import Base from '../../layouts/Base.astro';
import { lessonsByPhase, lessonUrl } from '../../lib/curriculum';

const groups = (await lessonsByPhase())
  .map(({ phase, lessons }) => ({
    phase,
    docs: lessons.filter((l) => l.data.deliverable),
  }))
  .filter((g) => g.docs.length > 0);

const total = groups.reduce((n, g) => n + g.docs.length, 0);
const questionCount = groups.reduce(
  (n, g) => n + g.docs.reduce((m, l) => m + (l.data.deliverable!.questions?.length ?? 0), 0),
  0,
);
---

<Base
  title="Toolkit"
  description="Every document the course asks you to produce, printable to A4 — blank for a pencil, or filled from your workbook."
>
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10"
      style="background: linear-gradient(180deg, var(--sky-low) 0%, var(--paper) 72%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-[84rem] px-4 sm:px-6 pt-12 pb-8">
      <h1
        class="font-display font-900 leading-[1.06] max-w-[18ch]"
        style="font-size: clamp(2.1rem, 1.4rem + 3vw, 3.5rem);"
      >
        {total} documents, and you have a design package
      </h1>
      <p class="mt-4 max-w-[64ch] text-lg leading-relaxed text-soft">
        Every deliverable in the course, in the order you produce them — {questionCount} questions in
        all. Answer them in the lesson and they collect in your
        <a href="/my/workbook/" class="underline underline-offset-2 hover:text-paw">workbook</a>. Or
        print them and take them outside, which is usually the better idea.
      </p>

      <p class="note mt-4 max-w-[64ch]">
        A printed sheet comes out blank, ready for a pencil. Sign in first and it comes out with
        whatever you have already written.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[84rem] px-4 sm:px-6 pb-16">
    <div class="grid gap-4">
      {
        groups.map(({ phase, docs }) => (
          <article class="cutout p-5">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="font-display font-700 text-xl sm:text-2xl leading-tight">
                {String(phase.number).padStart(2, '0')} — {phase.title}
              </h2>
              <span class="label">{docs.length} documents</span>
              <a
                href={`/toolkit/phase-${phase.number}/`}
                class="btn btn-ghost text-sm py-1.5 px-4 ml-auto"
              >
                Print the whole phase
              </a>
            </div>

            <ul class="grid gap-2 mt-4 sm:grid-cols-2">
              {docs.map((lesson) => {
                const d = lesson.data.deliverable!;
                return (
                  <li class="list-none">
                    <div class="marker p-3.5 h-full">
                      <p class="font-display font-700 leading-tight">{d.title}</p>
                      <p class="label mt-1">{d.questions?.length ?? 1} questions</p>
                      <div class="flex gap-3 mt-2">
                        <a
                          href={`/toolkit/${d.workbookKey}/`}
                          class="text-sm underline underline-offset-2 hover:text-paw"
                        >
                          Print
                        </a>
                        <a
                          href={lessonUrl(lesson)}
                          class="text-sm underline underline-offset-2 hover:text-paw"
                        >
                          Lesson
                        </a>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</Base>
