---
import { lessonUrl, difficultyLabel, type Lesson } from '../lib/curriculum';

interface Props {
  lesson: Lesson;
  showPhase?: boolean;
}
const { lesson, showPhase = false } = Astro.props;
const d = lesson.data;
---

<li class="list-none">
  <a href={lessonUrl(lesson)} class="seed-packet cutout-lift block p-4 sm:p-5 h-full">
    <div class="flex items-start gap-3">
      <span
        class="font-display font-900 text-sm shrink-0 w-9 h-9 rounded-full grid place-items-center mt-0.5"
        style="background: var(--surface-2); color: var(--ink-soft);"
      >
        {showPhase ? `${d.phase}.${d.order}` : String(d.order).padStart(2, '0')}
      </span>

      <div class="min-w-0 flex-1">
        <div class="flex items-start gap-2 flex-wrap">
          <h3 class="font-display font-700 text-lg sm:text-xl leading-tight">{d.title}</h3>
          {
            d.status === 'stub' && (
              <span class="label border-2 border-edge rounded-full px-2 py-0.5 shrink-0">
                Not written yet
              </span>
            )
          }
        </div>

        <p class="text-[0.95rem] leading-snug text-soft mt-1.5">{d.summary}</p>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2.5">
          <span class="label">⏱ {d.timeEstimate}</span>
          <span class="label">{difficultyLabel[d.difficulty]}</span>
          {d.series && <span class="label text-jac">💧 {d.series}</span>}
          {d.deliverable && <span class="label text-paw">📐 Makes: {d.deliverable.title}</span>}
          {d.licensedTrade && <span class="label text-banksia">⚠️ Licensed trade</span>}
        </div>
      </div>
    </div>
  </a>
</li>
