---
/**
 * The eleven phases as a garden path winding down the page.
 *
 * The numbering is not decoration — the phases are a genuine sequence, and
 * doing them out of order is how people end up paving over a soakwell. The
 * planting beside the path gets denser as you go, so the page itself shows the
 * garden establishing.
 */
import { phases } from '../data/phases';
import { blob } from '../lib/painterly';

interface Props {
  counts: Map<number, number>;
  /** Phases already completed, for the signed-in view. */
  done?: Set<number>;
}
const { counts, done = new Set<number>() } = Astro.props;

/** Little plants that appear beside the path, denser further along. */
const sprigs = (n: number) => Math.min(5, 1 + Math.floor(n / 2.4));

/**
 * Stepping stones, cut rather than turned.
 *
 * These were perfect circles, which no laid stone has ever been. Each one is a
 * blob path used as a clip-path, seeded from the phase number so it is stable
 * and no two stones in the column repeat.
 *
 * The path coordinates are in a 0–100 box because `clip-path: path()` does not
 * accept percentages; `clipPathUnits` on an SVG clipPath does, so the shapes go
 * through a hidden <svg> and are referenced by id.
 */
const stones = phases.map((phase) => ({
  number: phase.number,
  d: blob({
    cx: 0.5,
    cy: 0.5,
    rx: 0.47,
    ry: 0.45,
    lobes: 9,
    jitter: 0.09,
    seed: phase.number * 37,
  }),
}));
---

<svg aria-hidden="true" focusable="false" class="absolute w-0 h-0 overflow-hidden">
  <defs>
    {
      stones.map((s) => (
        <clipPath id={`stone-${s.number}`} clipPathUnits="objectBoundingBox">
          <path d={s.d} />
        </clipPath>
      ))
    }
  </defs>
</svg>

<ol class="relative">
  <!-- The path itself: small round pebbles running down behind the stones -->
  <div
    class="absolute left-[22px] sm:left-[29px] top-8 bottom-8 w-5 -z-10"
    style="background-image: radial-gradient(circle at 50% 50%, var(--edge-strong) 0 3.5px, transparent 4px); background-size: 20px 20px;"
    aria-hidden="true"
  >
  </div>

  {
    phases.map((phase) => {
      const count = counts.get(phase.number) ?? 0;
      const complete = done.has(phase.number);
      return (
        <li class="relative pl-16 sm:pl-24 pb-5 last:pb-0">
          {/* Stepping stone */}
          <a
            href={`/curriculum/${phase.slug}/`}
            class="stone absolute left-0 top-1 w-14 h-14 sm:w-[70px] sm:h-[70px] grid place-items-center font-display font-900 text-xl sm:text-2xl transition-transform duration-200 hover:scale-105 focus-visible:scale-105"
            style={`clip-path: url(#stone-${phase.number}); ${
              complete
                ? 'background: var(--leaf); color: #FFFDF7;'
                : 'background: var(--edge); color: var(--ink);'
            }`}
            aria-label={`Phase ${phase.number}: ${phase.title}`}
          >
            {complete ? '✓' : String(phase.number).padStart(2, '0')}
          </a>

          {/* Sprigs growing beside the stone */}
          <span
            class="absolute left-[46px] sm:left-[58px] top-[46px] sm:top-[58px] flex gap-1 items-end pointer-events-none"
            aria-hidden="true"
          >
            {Array.from({ length: sprigs(phase.number) }).map((_, i) => (
              <svg
                width="16"
                height={20 + ((i * 7) % 16)}
                viewBox="0 0 16 32"
                class="windy"
                style={`--wind-phase:${((phase.number * 0.07 + i * 0.05) % 1).toFixed(2)};--wind-amp:${2.4 + i * 0.4}deg`}
              >
                <path
                  d="M8 32V11"
                  stroke="var(--leaf)"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  fill="none"
                />
                <path d="M8 15q-7-3-8-10 7 0 8 10z" fill="var(--leaf)" />
                <path d="M8 20q7-3 8-9-7 0-8 9z" fill="var(--leaf)" opacity="0.8" />
              </svg>
            ))}
          </span>

          <article class="cutout cutout-lift p-4 sm:p-5">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="font-display font-700 text-2xl sm:text-[1.7rem] leading-tight">
                <a href={`/curriculum/${phase.slug}/`} class="hover:text-paw transition-colors">
                  {phase.title}
                </a>
              </h2>
              <span class="label">{count} lessons</span>
            </div>

            <p class="note mt-0.5">{phase.tagline}</p>
            <p class="mt-2.5 leading-relaxed text-soft text-[0.98rem]">{phase.description}</p>

            <p class="mt-3 text-[0.95rem] leading-relaxed">
              <span class="label block mb-0.5">You end up with</span>
              {phase.outcome}
            </p>
          </article>
        </li>
      );
    })
  }
</ol>

<style>
  /* A laid stone sits *in* the ground: a soft shadow beneath, no drawn border
     (a clip-path cannot carry one), and a hairline of lighter stone on top. */
  .stone {
    filter: drop-shadow(0 3px 0 var(--edge-strong))
      drop-shadow(0 8px 10px color-mix(in srgb, var(--ink) 30%, transparent));
  }
</style>
