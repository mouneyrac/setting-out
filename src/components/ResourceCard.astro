---
interface Resource {
  title: string;
  url: string;
  provider: string;
  type: string;
  cost: 'free' | 'freemium' | 'paid';
  price?: string;
  duration?: string;
  whyGood: string;
  waRelevance: 'wa-specific' | 'australian' | 'universal' | 'overseas-adapt';
  waCaveat?: string;
  checkedOn: Date;
}

interface Props {
  resource: Resource;
  context?: string;
  contextUrl?: string;
}
const { resource: r, context, contextUrl } = Astro.props;

const relevance: Record<Resource['waRelevance'], { label: string; emoji: string }> = {
  'wa-specific': { label: 'Perth / WA', emoji: '📍' },
  australian: { label: 'Australian', emoji: '🇦🇺' },
  universal: { label: 'Works anywhere', emoji: '🌏' },
  'overseas-adapt': { label: 'Overseas — adapt it', emoji: '✈️' },
};

const costLabel: Record<Resource['cost'], string> = {
  free: 'Free',
  freemium: 'Free tier',
  paid: 'Paid',
};

const rel = relevance[r.waRelevance];
---

<li class="cutout cutout-lift p-4 sm:p-5 list-none">
  <div class="flex flex-wrap items-center gap-2">
    <span
      class:list={[
        'font-display font-700 text-xs px-2.5 py-1 rounded-full border-2',
        r.cost === 'free'
          ? 'border-[var(--leaf)] text-leaf'
          : 'border-[var(--banksia)] text-banksia',
      ]}
    >
      {costLabel[r.cost]}{r.price && ` · ${r.price}`}
    </span>
    <span class="label">{r.type}</span>
    {r.duration && <span class="label">{r.duration}</span>}
    <span class:list={['label ml-auto', r.waRelevance === 'wa-specific' && 'text-leaf']}>
      <span aria-hidden="true">{rel.emoji}</span>
      {rel.label}
    </span>
  </div>

  <h3 class="font-display font-700 text-xl sm:text-[1.4rem] leading-tight mt-2.5">
    <a href={r.url} rel="noopener" class="hover:text-paw transition-colors">
      {r.title}
      <span class="text-soft text-base" aria-hidden="true">↗</span>
    </a>
  </h3>
  <p class="note mt-0.5">{r.provider}</p>

  <p class="mt-2.5 leading-relaxed text-[0.98rem]">
    <span class="label block mb-0.5">Why this one</span>
    {r.whyGood}
  </p>

  {
    r.waCaveat && (
      <div
        class="mt-3 rounded-xl p-3"
        style="background: color-mix(in srgb, var(--sky-high) 16%, var(--surface));"
      >
        <span class="label block mb-0.5">Change this for Perth</span>
        <p class="text-[0.95rem] leading-relaxed">{r.waCaveat}</p>
      </div>
    )
  }

  <p class="note mt-3 text-[0.9rem]">
    Link checked {
      r.checkedOn.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })
    }
    {
      context && contextUrl && (
        <>
          {' · from '}
          <a
            href={contextUrl}
            class="underline underline-offset-2 hover:text-paw transition-colors"
          >
            {context}
          </a>
        </>
      )
    }
  </p>
</li>
